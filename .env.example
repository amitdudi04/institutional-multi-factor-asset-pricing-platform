# No credentials are required during repository initialization.
# Future approved adapters must document variable names here using empty values.
# Never place real secrets in this file or commit a populated .env file.

# Required only for live SEC EDGAR retrieval. Use the owner's real contact.
IFP_SEC_CONTACT_EMAIL=

# Optional. FRED's CSV endpoint does not require it; future API routes may.
IFP_FRED_API_KEY=
