# Add only the credentials needed for the data sources you use.
# Never place real secrets in this file or commit a populated .env file.

# Required only for live SEC EDGAR retrieval. Use the owner's real contact.
IFP_SEC_CONTACT_EMAIL=

# Optional. FRED's CSV endpoint does not require it; future API routes may.
IFP_FRED_API_KEY=
# Required for free historical active/delisted listing lifecycle evidence.
IFP_ALPHA_VANTAGE_API_KEY=
# Required for CC BY 4.0 daily U.S. equity market evidence.
IFP_HF_DATA_LIBRARY_API_KEY=
# Optional local API bearer token. Leave unset for loopback-only anonymous use.
# IFP_API_TOKEN=
